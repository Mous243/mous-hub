# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tu correo: el MISMO del usuario creado en Supabase Auth y del SQL generado
NEXT_PUBLIC_OWNER_EMAIL=
# Pie de recibos y presentaciones (opcionales)
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_WEB=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
# Solo Windows, tras ejecutar tools/abrir-carpeta/instalar.ps1: pon 1 para ver el botón «Abrir carpeta»
NEXT_PUBLIC_ABRIR_CARPETA=
# Secreto de las tareas automáticas: el MISMO valor que se usa al generar el SQL (npm run sql)
CRON_SECRET=
# Avisos por Telegram (opcionales)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
